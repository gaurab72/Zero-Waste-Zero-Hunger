# Payment Gateway Credentials
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit .env to version control.

# =====================
# eSewa (NPR)
# =====================
# Get UAT test credentials from: https://developer.esewa.com.np
# Public test product code: EPAYTEST
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=your_esewa_secret_key_here
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# For production, replace with live credentials:
# ESEWA_PRODUCT_CODE=your_live_product_code
# ESEWA_SECRET_KEY=your_live_secret_key
# ESEWA_PAYMENT_URL=https://epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_URL=https://esewa.com.np/api/epay/transaction/status/

# =====================
# Khalti (NPR)
# =====================
# Get sandbox credentials from: https://test-admin.khalti.com
# Signup as merchant, use OTP: 987654, then copy your live_secret_key
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455

# For production, replace with live credentials:
# KHALTI_MODE=live
# KHALTI_SECRET_KEY=your_live_secret_key_here

# =====================
# PayPal (USD)
# =====================
# Get sandbox credentials from: https://developer.paypal.com
# Create a REST app, copy client_id and client_secret
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_CURRENCY=USD

# For production, replace with live credentials:
# PAYPAL_MODE=live
# PAYPAL_CLIENT_ID=your_live_client_id_here
# PAYPAL_CLIENT_SECRET=your_live_client_secret_here
